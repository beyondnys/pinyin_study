# 复制为 .env 后修改；.env 优先级高于 config.py 默认值
DATABASE_URL=mysql+pymysql://pinyin_game:your_password@127.0.0.1:3306/pinyin_game?charset=utf8mb4
# 无密码
REDIS_URL=redis://127.0.0.1:6379/0
# 有密码（例如 requirepass redis123）时写法：
# REDIS_URL=redis://:redis123@127.0.0.1:6379/0
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRE_DAYS=7
SINGLE_LOGIN=false
CORS_ORIGINS=*
