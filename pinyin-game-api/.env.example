# 复制为 .env 后修改；.env 优先级高于 config.py 默认值
DATABASE_URL=mysql+pymysql://pinyin_game:your_password@127.0.0.1:3306/pinyin_game?charset=utf8mb4
# 无密码
REDIS_URL=redis://127.0.0.1:6379/0
# 有密码（例如 requirepass redis123）时写法：
# REDIS_URL=redis://:redis123@127.0.0.1:6379/0
JWT_SECRET=change-me-in-production-use-long-random-string-32
JWT_EXPIRE_DAYS=7
SINGLE_LOGIN=false
CORS_ORIGINS=*

# MinIO（生产请修改密钥，勿提交真实密码）
MINIO_ENDPOINT=minio.beyondttyy.top
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=your-minio-secret
MINIO_BUCKET=tts
MINIO_SECURE=true
MINIO_PRESIGN_EXPIRE_SECONDS=604800
# 是否在 API 启动时自动 HeadBucket/建桶（多数环境需在控制台先建桶并设 false）
MINIO_AUTO_CREATE_BUCKET=false

# TTS（edge-tts）
TTS_PROVIDER=edge
TTS_DEFAULT_VOICE=zh-CN-XiaoxiaoNeural
TTS_MAX_TEXT_LEN=200
TTS_TIMEOUT_SECONDS=180
TTS_CONNECT_TIMEOUT_SECONDS=30
TTS_RECEIVE_TIMEOUT_SECONDS=120
TTS_RETRY_ATTEMPTS=3
TTS_RETRY_DELAY_SECONDS=2.0
TTS_BATCH_DELAY_SECONDS=0.2
