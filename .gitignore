# =========================
# 拼音练习系统 - Git 忽略
# =========================

# ----- 操作系统 -----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# ----- Python（pinyin-game-api） -----
**/__pycache__/
**/*.py[cod]
**/*$py.class
**/.Python
**/*.so
**/.eggs/
**/*.egg-info/
**/*.egg
**/build/
**/dist/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.coverage
**/.coverage.*
**/htmlcov/
**/.tox/
**/.nox/

# 虚拟环境
**/.venv/
**/venv/
**/ENV/
**/env/

# ----- Node（pinyin-game-web / pinyin-game-admin） -----
**/node_modules/
**/dist/
**/.npm/
**/.pnpm-store/
**/.yarn/
**/.pnp.*
**/.turbo/
**/*.tsbuildinfo

# Vite / 前端本地环境
**/.env.local
**/.env.*.local
**/.vite/

# ----- 敏感配置（勿提交密钥） -----
.env
**/.env
!**/.env.example
!.env.example

# 本地数据库/Redis 等覆盖配置
**/local.settings.json
**/secrets.json
**/*.pem
**/*.key

# ----- IDE / 编辑器 -----
.idea/
**/.idea/
.vscode/
**/.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-workspace
*.sublime-project
*.iml

# ----- 日志与临时文件 -----
**/*.log
**/logs/
**/tmp/
**/temp/
**/.cache/

# ----- 打包与部署产物 -----
**/*.tar.gz
**/*.zip
**/coverage/

# ----- 可选：本地上传/媒体（若后续有用户上传目录） -----
**/uploads/
**/media/
